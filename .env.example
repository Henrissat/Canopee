# Colle ici l'URL Neon (Postgres, sslmode=require).
# Pour `npm run db:push`, la connection string directe est plus fiable que le pooler.
# Exemple : postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js (obligatoire en prod)
# Générer : openssl rand -base64 32
AUTH_SECRET=""

# Compte créé au seed. Change le mot de passe après la première connexion.
# C'est aussi la serre affichée en lecture publique (visiteurs non connectés).
AUTH_ADMIN_EMAIL="admin@canopee.local"
AUTH_ADMIN_PASSWORD="changeme-canopee"

# Cloudinary (optionnel — plan gratuit). Sans ces variables, une URL de photo suffit.
# 1. Dashboard → Product environment credentials → Cloud name
# 2. Settings → Upload → Upload presets → Unsigned, folder canopee
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
